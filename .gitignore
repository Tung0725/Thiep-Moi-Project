.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IntelliJ IDEA & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace

# ==========================================
# 2. Backend (Java / Spring Boot / Maven)
# ==========================================
# Build outputs
target/
**/target/
build/
**/build/
out/
**/out/

# Compiled Java binaries
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs
*.log
logs/
**/logs/

# JVM crash logs
hs_err_pid*
replay_pid*

# ==========================================
# 3. Frontend (Next.js / Node.js / React)
# ==========================================
# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.*

# Next.js build artifacts
.next/
**/.next/
coverage/
**/coverage/
dist/
**/dist/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Python extractor caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 4. Environment Variables & Secrets (OWASP)
# ==========================================
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key

# ==========================================
# 5. Project Specific Exclusions
# ==========================================
/web_cloned/
/.agents/
/my-archiving-session/
/extracted_templates/*

# Keep reusable source-capture tools; captures, archives and browser profiles stay local.
!/extracted_templates/capture-blueprint.mjs
!/extracted_templates/capture-trees.mjs

# Generated file-by-file cleanup inventories
/.local-inventory/
*.warc
*.warc.gz
*.wacz
# tools/ contains maintained extraction/import scripts and documentation; keep it in Git.