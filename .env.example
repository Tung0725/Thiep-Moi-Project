# Database Configuration
DB_NAME=wedding_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
# 5433 avoids conflict with any existing local PostgreSQL service
DB_PORT=5433

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false

# Gmail verification emails
MAIL_USERNAME=
MAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:3000

# Object Storage Configuration (MinIO for MVP / AWS S3 for Production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here
STORAGE_BUCKET_NAME=wedding-media
STORAGE_REGION=us-east-1

# Initial Admin Bootstrap Account (optional; leave password blank in shared files)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
